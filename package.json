{
  "name": "afls",
  "private": true,
  "version": "0.2.7",
  "description": "AFLS — a deep American football management simulation",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx scripts/check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "tsx scripts/calibrate.ts",
    "endings": "tsx scripts/endings.ts",
    "offseason": "tsx scripts/offseason.ts",
    "audit": "tsx scripts/audit.ts",
    "careers": "tsx scripts/careers.ts",
    "quirks": "tsx scripts/quirks.ts",
    "coach-quirks": "tsx scripts/coach-quirks.ts",
    "weather": "tsx scripts/weather.ts",
    "size": "tsx scripts/size.ts",
    "crews": "tsx scripts/crews.ts",
    "trades": "tsx scripts/trades.ts",
    "training": "tsx scripts/training.ts",
    "waivers": "tsx scripts/waivers.ts",
    "squads": "tsx scripts/squads.ts",
    "squad-careers": "tsx scripts/squad-careers.ts",
    "elevations": "tsx scripts/elevations.ts",
    "poaching": "tsx scripts/poaching.ts",
    "gm:playthrough": "tsx scripts/gm-playthrough.ts",
    "gm:ten-years": "tsx scripts/gm-ten-years.ts",
    "screens": "tsx scripts/screens.ts",
    "coach-gallery": "tsx scripts/coach-gallery.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
